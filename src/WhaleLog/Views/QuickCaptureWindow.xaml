<Window x:Class="WhaleLog.Views.QuickCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:WhaleLog.Views"
        Title="记一笔"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="580"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="12"
            Padding="16,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.34" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Image Source="{v:AssetImage whale-head}"
                       Width="22" Height="22" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="记一笔" FontSize="13" FontWeight="Medium" Margin="8,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="DateHint" FontSize="11.5" Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <TextBox x:Name="Input"
                     Style="{StaticResource FlatTextBox}"
                     MinHeight="76"
                     MaxHeight="240"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="13.5"
                     PreviewKeyDown="OnInputPreviewKeyDown" />

            <Grid Margin="0,10,0,0">
                <StackPanel x:Name="CategoryChips" Orientation="Horizontal" VerticalAlignment="Center" />
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="Enter 保存 · Shift+Enter 换行 · Esc 关闭" />
            </Grid>

            <TextBlock Margin="0,8,0,0" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="提示：以 #标签 开头可以顺带打个标签，例如「#周报 整理完第三季度数据」" />
        </StackPanel>
    </Border>
</Window>
