<Window x:Class="WhaleLog.Views.EditEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:WhaleLog.Views"
        Title="编辑记录"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="560"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.34" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!--
                标题栏（可拖动）。
                日期刻意写在标题上：从「往期」翻回几天前改东西时，
                没有这一行很容易记不清正在改的是哪天的记录。
            -->
            <Grid MouseLeftButtonDown="OnHeaderDrag">
                <StackPanel Orientation="Horizontal" Margin="16,12,0,12">
                    <Image Source="{v:AssetImage whale-head}"
                           Width="20" Height="20" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="编辑记录" FontSize="13.5" FontWeight="Medium" Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="DateHint" FontSize="11.5" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <Button Content="✕" Width="38" Height="28" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,12,0"
                        Style="{StaticResource GhostButton}" Padding="0"
                        Click="OnCancelClick" />
            </Grid>

            <!-- 正文 -->
            <TextBox x:Name="BodyInput"
                     Style="{StaticResource FlatTextBox}"
                     Margin="16,0"
                     MinHeight="76" MaxHeight="220"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="13.5"
                     PreviewKeyDown="OnInputKeyDown" />

            <!-- 分类 -->
            <StackPanel Margin="16,12,16,0">
                <TextBlock Text="分类" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel x:Name="CategoryChips" Orientation="Horizontal" Margin="0,7,0,0" />
            </StackPanel>

            <!-- 标签 -->
            <Grid Margin="16,12,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="标签" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <!--
                    这里刻意**不写死 Height**。FlatTextBox 自带 Padding="10,7"，
                    给个 30px 的固定高度会把内容区压到只剩十几个像素，字直接被裁没 ——
                    界面上看就是"标签框是空的"，而赋值其实是对的。让它自己撑开最稳。
                -->
                <TextBox x:Name="TagInput" Grid.Column="1"
                         Style="{StaticResource FlatTextBox}"
                         FontSize="12.5"
                         PreviewKeyDown="OnInputKeyDown"
                         ToolTip="自由标签，多个用逗号分隔；不填就是没有标签" />
            </Grid>

            <!-- 提示 + 按钮 -->
            <Grid Margin="16,14,16,16">
                <TextBlock x:Name="HintText" FontSize="11.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="Enter 保存 · Shift+Enter 换行 · Esc 取消" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource GhostButton}"
                            Padding="14,5" Click="OnCancelClick" />
                    <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0" Click="OnSaveClick" />
                </StackPanel>
            </Grid>

            <!--
                编辑范围说明。写完才发现「改的是哪天、改完哪些地方跟着变」
                在界面上完全没有交代 —— 而这两件事都是隐式规则。
            -->
            <TextBlock Margin="16,0,16,14" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="只改这一条记录的内容。若这条已顺延出副本，副本是独立的一条，不受影响。" />
        </StackPanel>
    </Border>
</Window>
