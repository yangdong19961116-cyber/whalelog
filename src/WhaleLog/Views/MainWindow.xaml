<Window x:Class="WhaleLog.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:models="clr-namespace:WhaleLog.Models"
        xmlns:v="clr-namespace:WhaleLog.Views"
        Title="鲸记 WhaleLog"
        Width="1000" Height="700"
        MinWidth="860" MinHeight="580"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!--
            文件卡片。文件归档页和今日记录页共用这一份 —— 两处各写一遍的话，
            改一处忘了另一处就会长得不一样，而"样式保持一致"正是这里的要求。
            自带下外边距，所以堆叠时天然不会挤在一起。
        -->
        <DataTemplate x:Key="FileCardTemplate">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="12,10" Margin="0,0,4,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="9" Height="9" CornerRadius="4.5"
                            VerticalAlignment="Top" Margin="0,5,0,0"
                            Background="{Binding Category, Converter={StaticResource CategoryBrush}}" />

                    <StackPanel Grid.Column="1" Margin="11,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FileName}" FontSize="13"
                                       FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="{Binding VersionText}" FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="Medium" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Category}" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="·" FontSize="11.5" Margin="6,0"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SizeText}" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="·" FontSize="11.5" Margin="6,0"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding AddedStampText}" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding MatchedRule}" FontSize="11.5"
                                       Margin="6,0,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="{Binding MatchedRule, Converter={StaticResource NonEmptyToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource PathText}"
                                   Margin="0,3,0,0"
                                   Foreground="{Binding IsMissing, Converter={StaticResource MissingToBrush}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="打开位置" Style="{StaticResource TinyGhostButton}"
                                Tag="{Binding}" Click="OnRevealFileClick" />
                        <Button Content="版本" Style="{StaticResource TinyGhostButton}"
                                Margin="6,0,0,0" Tag="{Binding}"
                                Click="OnShowVersionsClick" />
                        <Button Content="移除" Style="{StaticResource TinyDangerButton}"
                                Margin="6,0,0,0" Tag="{Binding}"
                                Click="OnRemoveFileClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            归档页目录条上的一颗日期胶囊（「9月24日  21」）。
            是 Button 不是 ToggleButton：点它不改变任何筛选状态，只是把列表滚到那一组 ——
            做成 toggle 的话勾选态就成了一种"筛选"，和右上的「只看当天 / 全部」撞车。
        -->
        <Style x:Key="DateChipButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,6,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11" Padding="9,3"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 标题栏 ============ -->
        <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Source="{v:AssetImage whale-head}"
                       Width="26" Height="26" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="鲸记" FontSize="14" FontWeight="Medium" Margin="9,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderSubtitle" Margin="10,0,0,0" FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,6,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinButton" Content="—" Width="40" Height="30"
                        Style="{StaticResource GhostButton}" Padding="0"
                        BorderThickness="0" Click="OnMinimizeClick" />
                <Button x:Name="CloseButton" Content="✕" Width="40" Height="30"
                        Style="{StaticResource GhostButton}" Padding="0"
                        BorderThickness="0" Click="OnCloseClick" />
            </StackPanel>
        </Grid>

        <!-- ============ 导航 ============ -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Top"
                    Margin="20,16,20,0">
            <ToggleButton x:Name="NavNotes" Content="今日记录" Style="{StaticResource NavToggle}"
                          IsChecked="True" Click="OnNavClick" />
            <ToggleButton x:Name="NavFiles" Content="文件归档" Style="{StaticResource NavToggle}"
                          Click="OnNavClick" />
            <ToggleButton x:Name="NavSettings" Content="设置" Style="{StaticResource NavToggle}"
                          Click="OnNavClick" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,58,0,0">
            <Grid Grid.Row="0" x:Name="PageNotes" Margin="20,14,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 日期 + 统计 -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="‹" Style="{StaticResource GhostButton}" Padding="11,4"
                                Click="OnPrevDayClick" ToolTip="上一天（Alt + ←）" />
                        <Button x:Name="DateButton" Style="{StaticResource GhostButton}"
                                Padding="10,4" Margin="8,0" Click="OnDateButtonClick"
                                ToolTip="点开可以按整月跳转">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DateText" FontSize="15" FontWeight="Medium"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="▾" FontSize="11" Margin="7,1,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Content="›" Style="{StaticResource GhostButton}" Padding="11,4"
                                Click="OnNextDayClick" ToolTip="下一天（Alt + →）" />
                        <!--
                            往期清单。和「‹ ›」并存而不是取代它们：
                            「‹」是"我想看昨天"，往期是"我想找哪天记过东西" —— 两个不同的意图。
                            从今天翻回两周前要点十几次「‹」，清单里是一下。
                        -->
                        <Button x:Name="RecentButton" Style="{StaticResource GhostButton}"
                                Padding="10,4" Margin="8,0,0,0" Click="OnRecentButtonClick"
                                ToolTip="列出所有有记录的日子，点一下直接跳过去（Alt + ← / → 跳到相邻有记录的一天）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="往期" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="▾" FontSize="11" Margin="7,1,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Content="回到今天" Style="{StaticResource TinyGhostButton}" Margin="10,0,0,0"
                                Click="OnTodayClick" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="StatOpen" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0" />
                        <TextBlock x:Name="StatDone" FontSize="12"
                                   Foreground="{DynamicResource SuccessBrush}" Margin="0,0,16,0" />
                        <TextBlock x:Name="StatFiles" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- 整月日历弹出层（StaysOpen=False：点外面就收） -->
                    <Popup x:Name="DatePopup" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Fade" Placement="Bottom"
                           PlacementTarget="{Binding ElementName=DateButton}"
                           HorizontalOffset="-14" VerticalOffset="4"
                           Closed="OnDatePopupClosed">
                        <v:MonthCalendarPanel x:Name="MonthPanel" />
                    </Popup>

                    <!-- 往期清单弹出层。和月历各管一件事：
                         月历是"我知道大概是哪天"，这一列是"带我去有记录的那天"。 -->
                    <Popup x:Name="RecentPopup" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Fade" Placement="Bottom"
                           PlacementTarget="{Binding ElementName=RecentButton}"
                           HorizontalOffset="-14" VerticalOffset="4"
                           Closed="OnRecentPopupClosed">
                        <v:RecentDaysPanel x:Name="RecentPanel" />
                    </Popup>
                </Grid>

                <!-- 输入区 -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,14">
                    <StackPanel>
                        <TextBox x:Name="EntryInput" Style="{StaticResource FlatTextBox}"
                                 Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 KeyDown="OnEntryInputKeyDown" />
                        <Grid Margin="0,10,0,0">
                            <StackPanel x:Name="CategoryChips" Orientation="Horizontal"
                                        VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Ctrl + Enter 快速添加" FontSize="11.5"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <Button x:Name="AddEntryButton" Content="添加记录"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="OnAddEntryClick" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 记录列表 -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Style="{StaticResource SlimScroller}" Grid.Row="0">
                        <StackPanel>
                            <ItemsControl x:Name="EntryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="10"
                                                Padding="12,9" Margin="0,0,4,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" Style="{StaticResource FlatCheckBox}"
                                                          IsChecked="{Binding Done, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Checked="OnEntryDoneChanged" Unchecked="OnEntryDoneChanged" />

                                                <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                                                           Margin="12,0,10,0" VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextMutedBrush}" />

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Border Width="7" Height="7" CornerRadius="3.5"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding Category, Converter={StaticResource CategoryBrush}}" />
                                                        <TextBlock Text="{Binding Category}" FontSize="11.5" Margin="6,0,0,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding Tag}" FontSize="11.5" Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="3" Text="{Binding DurationText}"
                                                           Margin="10,0,10,0" VerticalAlignment="Center"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource SuccessBrush}" />

                                                <Button Grid.Column="4" Content="删除"
                                                        Style="{StaticResource TinyDangerButton}"
                                                        Tag="{Binding}" Click="OnDeleteEntryClick"
                                                        VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="EntryEmptyHint" Margin="0,26,0,0"
                                       HorizontalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="今天还没有记录。上面写一条，或者把文件拖进来。" />

                            <!--
                                今天归档的文件。和「文件归档」页共用 FileCardTemplate，样式天然一致。
                                它跟事项列表同处一个 StackPanel 里，所以多条文件是顺着往下堆叠的，
                                卡片自带下外边距，不会互相压住。
                            -->
                            <StackPanel x:Name="DayFilesSection" Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                <Grid Margin="0,0,4,2">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="DayFilesTitle" Text="今日归档的文件"
                                                   FontSize="12.5" FontWeight="Medium" />
                                        <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="7"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock x:Name="DayFilesCountText" FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <Button Content="去归档 ›" Style="{StaticResource TinyGhostButton}"
                                            HorizontalAlignment="Right" Click="OnGoToFilesPageClick" />
                                </Grid>

                                <ItemsControl x:Name="DayFileList"
                                              ItemTemplate="{StaticResource FileCardTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,4,0" Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="今日小结" FontSize="12.5" FontWeight="Medium"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="复制小结" Style="{StaticResource TinyGhostButton}"
                                            Click="OnCopySummaryClick" />
                                    <Button Content="生成日报" Style="{StaticResource TinyGhostButton}"
                                            Margin="6,0,0,0" Click="OnDailyReportClick" />
                                    <Button Content="本周周报" Style="{StaticResource TinyGhostButton}"
                                            Margin="6,0,0,0" Click="OnWeeklyReportClick" />
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="SummaryInput" Style="{StaticResource FlatTextBox}"
                                     Margin="0,8,0,0" Height="56" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="OnSummaryChanged" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== 文件归档页 ==================== -->
            <Grid x:Name="PageFiles" Margin="20,14,20,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="FileFilterToday" Content="只看当天"
                                      Style="{StaticResource ChipToggle}" IsChecked="True"
                                      ToolTip="只显示当前查看日期归档的文件（不是字面的「今天」）"
                                      Click="OnFileFilterClick" />
                        <ToggleButton x:Name="FileFilterAll" Content="全部"
                                      Style="{StaticResource ChipToggle}"
                                      Click="OnFileFilterClick" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!--
                            搜索框。带一个自己的占位提示（WPF 的 TextBox 没有 placeholder），
                            提示在框里垫着、有字就隐藏 —— 放在框外面会多占一列宽度，
                            而这一行右边本来就挤着统计文字和按钮。
                        -->
                        <Grid Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBox x:Name="FileSearchBox" Width="182"
                                     Style="{StaticResource FlatTextBox}"
                                     Padding="8,3" FontSize="12"
                                     TextChanged="OnFileSearchTextChanged"
                                     ToolTip="按文件名 / 类别 / 路径 / 备注筛（搜的是全部文件，不受上面两颗胶囊限制）" />
                            <TextBlock x:Name="FileSearchPlaceholder" Text="搜文件名 / 类别"
                                       FontSize="12" Margin="10,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </Grid>
                        <TextBlock x:Name="FileStatText" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" />
                        <Button Content="打开数据目录" Style="{StaticResource TinyGhostButton}"
                                Click="OnOpenDataFolderClick" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0"
                        Padding="16,13" Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="DropBannerIcon" Source="{v:AssetImage whale-head}"
                               Width="30" Height="30" Stretch="Uniform" VerticalAlignment="Center" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DropBannerTitle" Text="把今天的文件拖到这里" FontSize="13" FontWeight="Medium" />
                            <TextBlock x:Name="DropBannerHint" FontSize="11.5" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="自动识别类别、记录所在位置并标记版本。原文件不会被移动或修改。" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--
                    归档日历。以前这里是一排会无限长下去的日期胶囊（有归档的一天一颗），
                    归档攒到几百天就糊成好几行、还得自己上下找。
                    日历永远是固定的 42 格：哪天有归档、各有多少，一格一格看过去就行，
                    不会再"堆积在一起"。

                    和今日记录页那个月历是**同一个控件**（MonthCalendarPanel），
                    差别只在口径 —— 这里传"日期 → 文件数"，于是圆点旁边多一个小数字。

                    日历本体挂在 Popup 里：它高 300 多 DIP，直接摊在这一页会把下面的
                    文件列表压到只剩一两张卡片（主面板默认才 700 高）。
                -->
                <StackPanel x:Name="FileCalendarBar" Grid.Row="2" Orientation="Horizontal"
                            Margin="0,10,0,0" Visibility="Collapsed">
                    <Button x:Name="FileCalendarButton" Style="{StaticResource GhostButton}"
                            Padding="10,4" Click="OnFileCalendarButtonClick"
                            ToolTip="按整月挑日期：有归档的日子标一个蓝点和当天数量，点一下滚到那一组">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="归档日历" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="FileCalendarAnchorText" FontSize="13" FontWeight="Medium"
                                       Margin="7,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="▾" FontSize="11" Margin="7,1,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Button>

                    <!--
                        没标归档日期的文件在日历上没有落点（键就是日期本身）。
                        改版前它是一颗「未标注日期」的胶囊，得给它留个入口，
                        否则那些人会从界面上彻底消失。
                    -->
                    <Button x:Name="FileUndatedButton" Style="{StaticResource DateChipButton}"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="Collapsed" Click="OnFileUndatedClick" />

                    <Popup x:Name="FileCalendarPopup" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Fade" Placement="Bottom"
                           PlacementTarget="{Binding ElementName=FileCalendarButton}"
                           HorizontalOffset="-14" VerticalOffset="4"
                           Closed="OnFileCalendarPopupClosed">
                        <v:MonthCalendarPanel x:Name="FileCalendarPanel" />
                    </Popup>
                </StackPanel>

                <Grid x:Name="FileDropZone" Grid.Row="3" Margin="0,12,0,0">
                    <ScrollViewer Style="{StaticResource SlimScroller}">
                        <StackPanel>
                            <ItemsControl x:Name="FileList"
                                          ItemTemplate="{StaticResource FileCardTemplate}">
                                <!-- 分组栏头只在「全部」视图出现（只看当天只有一个日期，再加栏头就是噪音） -->
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,11,4,7" Padding="10,5" CornerRadius="8"
                                                        Background="{DynamicResource AccentSoftBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Width="5" Height="5" CornerRadius="2.5"
                                                                    VerticalAlignment="Center"
                                                                    Background="{DynamicResource AccentBrush}" />
                                                            <TextBlock Margin="7,0,0,0" FontSize="12.5" FontWeight="Medium"
                                                                       Text="{Binding Name, Converter={StaticResource DateGroupLabel}}" />
                                                        </StackPanel>
                                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Text="{Binding ItemCount, StringFormat={}{0} 个文件}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                            </ItemsControl>

                            <TextBlock x:Name="FileEmptyHint" Margin="0,26,0,0"
                                       HorizontalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="还没有归档文件。把文件拖到窗口里试试。" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ==================== 设置页 ==================== -->
            <ScrollViewer x:Name="PageSettings" Margin="20,14,20,0" Visibility="Collapsed"
                          Style="{StaticResource SlimScroller}">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="上下班与提醒" Style="{StaticResource H2Text}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12"
                                       Text="到点前会依次用桌面小鲸鱼气泡、提示音、系统托盘通知提醒你。" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="上班" VerticalAlignment="Center" FontSize="13" />
                                <TextBox x:Name="WorkStartBox" Style="{StaticResource FlatTextBox}"
                                         Width="70" Margin="10,0,6,0" TextChanged="OnWorkTimeChanged" />
                                <TextBlock Text=": 00" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="下班" VerticalAlignment="Center" FontSize="13" Margin="26,0,0,0" />
                                <TextBox x:Name="WorkEndBox" Style="{StaticResource FlatTextBox}"
                                         Width="70" Margin="10,0,6,0" TextChanged="OnWorkTimeChanged" />
                                <TextBlock Text=": 00" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="提前" VerticalAlignment="Center" FontSize="13" Margin="26,0,0,0" />
                                <TextBox x:Name="RemindBeforeBox" Style="{StaticResource FlatTextBox}"
                                         Width="60" Margin="10,0,6,0" TextChanged="OnRemindBeforeChanged" />
                                <TextBlock Text="分钟提醒" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                       Text="小时填 0-23，分钟固定按整点。下班后若当天仍无记录，会按下面的间隔再提醒。" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <CheckBox x:Name="ReminderEnabledBox" Style="{StaticResource FlatCheckBox}"
                                          Content="启用下班提醒" Click="OnReminderToggle" />
                                <CheckBox x:Name="ReminderSoundBox" Style="{StaticResource FlatCheckBox}"
                                          Content="提示音" Margin="24,0,0,0" Click="OnReminderToggle" />
                                <CheckBox x:Name="ReminderBalloonBox" Style="{StaticResource FlatCheckBox}"
                                          Content="系统托盘通知" Margin="24,0,0,0" Click="OnReminderToggle" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="下班后每隔" VerticalAlignment="Center" FontSize="13" />
                                <TextBox x:Name="NudgeBox" Style="{StaticResource FlatTextBox}"
                                         Width="60" Margin="10,0,6,0" TextChanged="OnNudgeChanged" />
                                <TextBlock Text="分钟再提醒一次（填 0 表示不再提醒）"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="快速记录" Style="{StaticResource H2Text}" />
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,12"
                                       TextWrapping="Wrap"
                                       Text="任何时候按一下组合键，屏幕光标旁就会弹出一个小输入框，敲完 Enter 就存进当天的记录里，不用先打开这个面板。" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="QuickCaptureEnabledBox" Style="{StaticResource FlatCheckBox}"
                                          Content="启用全局快捷键" Click="OnQuickCaptureToggle" />
                                <Border Margin="20,0,0,0" Padding="8,4" CornerRadius="6"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1">
                                    <TextBlock x:Name="HotKeyText" FontSize="12.5"
                                               FontFamily="Cascadia Mono, Consolas, monospace" />
                                </Border>
                                <Button x:Name="RecordHotKeyButton" Content="录制快捷键"
                                        Style="{StaticResource TinyGhostButton}" Margin="10,0,0,0"
                                        Click="OnRecordHotKeyClick" />
                                <Button Content="恢复默认" Style="{StaticResource TinyGhostButton}"
                                        Margin="6,0,0,0" Click="OnResetHotKeyClick" />
                                <TextBlock x:Name="HotKeyHint" VerticalAlignment="Center" Margin="12,0,0,0"
                                           FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="桌面小鲸鱼" Style="{StaticResource H2Text}" />
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,12"
                                       Text="拖动可以移动位置，松手自动吸附到最近的屏幕边缘；不操作时收起成小圆头像，鼠标移上去展开。把文件拖到小鲸鱼身上可以直接归档。" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="FloatingEnabledBox" Style="{StaticResource FlatCheckBox}"
                                          Content="显示悬浮窗" Click="OnFloatingToggle" />
                                <CheckBox x:Name="FloatingSnapBox" Style="{StaticResource FlatCheckBox}"
                                          Content="松手吸附屏幕边缘" Margin="24,0,0,0" Click="OnFloatingToggle" />
                                <CheckBox x:Name="FloatingCollapseBox" Style="{StaticResource FlatCheckBox}"
                                          Content="不用时收起成小图标" Margin="24,0,0,0" Click="OnFloatingToggle" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <CheckBox x:Name="FloatingDropOpenBox" Style="{StaticResource FlatCheckBox}"
                                          Content="文件拖到小鲸鱼上时，自动打开主面板并切到归档页"
                                          Click="OnFloatingToggle" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Text="大小" VerticalAlignment="Center" FontSize="13" Width="34" />
                                <Slider x:Name="ScaleSlider" Width="180"
                                        Minimum="{x:Static models:AppSettings.MinFloatingScale}"
                                        Maximum="{x:Static models:AppSettings.MaxFloatingScale}"
                                        TickFrequency="0.05" IsMoveToPointEnabled="True"
                                        VerticalAlignment="Center" />
                                <TextBlock x:Name="ScaleText" VerticalAlignment="Center" Margin="10,0,0,0"
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="透明" VerticalAlignment="Center" FontSize="13" Width="34" />
                                <Slider x:Name="OpacitySlider" Width="180"
                                        Minimum="{x:Static models:AppSettings.MinFloatingOpacity}"
                                        Maximum="{x:Static models:AppSettings.MaxFloatingOpacity}"
                                        TickFrequency="0.05" IsMoveToPointEnabled="True"
                                        VerticalAlignment="Center" />
                                <TextBlock x:Name="OpacityText" VerticalAlignment="Center" Margin="10,0,0,0"
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>

                            <!-- 形象切换：按钮是按磁盘上实际找到的形象包动态生成的 -->
                            <TextBlock Text="形象" FontSize="13" Margin="0,16,0,6" />
                            <WrapPanel x:Name="CharacterChips" Orientation="Horizontal" />
                            <TextBlock x:Name="CharacterHint" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="文件归档" Style="{StaticResource H2Text}" />
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,12"
                                       Text="默认只记录文件所在位置和内容指纹，不动你的原文件。开启快照后，每个版本会额外复制一份到数据目录，可回滚。" />
                            <CheckBox x:Name="SnapshotBox" Style="{StaticResource FlatCheckBox}"
                                      Content="开启归档快照（每个版本复制一份副本，占磁盘）"
                                      Click="OnSnapshotToggle" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Text="超过" VerticalAlignment="Center" FontSize="13" />
                                <TextBox x:Name="HashLimitBox" Style="{StaticResource FlatTextBox}"
                                         Width="70" Margin="10,0,6,0" TextChanged="OnHashLimitChanged" />
                                <TextBlock Text="MB 的文件改用采样指纹（大文件全量哈希较慢，采样后仍能可靠判断内容是否变化）"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="外观与启动" Style="{StaticResource H2Text}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="主题" VerticalAlignment="Center" FontSize="13" Margin="0,0,12,0" />
                                <ToggleButton x:Name="ThemeSystem" Content="跟随系统"
                                              Style="{StaticResource ChipToggle}" Click="OnThemeClick" />
                                <ToggleButton x:Name="ThemeLight" Content="浅色"
                                              Style="{StaticResource ChipToggle}" Click="OnThemeClick" />
                                <ToggleButton x:Name="ThemeDark" Content="深色"
                                              Style="{StaticResource ChipToggle}" Click="OnThemeClick" />
                            </StackPanel>
                            <CheckBox x:Name="StartupBox" Style="{StaticResource FlatCheckBox}" Margin="0,16,0,0"
                                      Content="开机自动启动（最小化到托盘）" Click="OnStartupToggle" />
                            <CheckBox x:Name="HideOnCloseBox" Style="{StaticResource FlatCheckBox}" Margin="0,12,0,0"
                                      Content="点击关闭按钮时最小化到托盘而不是退出" Click="OnHideOnCloseToggle" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="创建桌面快捷方式" Style="{StaticResource GhostButton}"
                                        Click="OnCreateShortcutClick" />
                                <TextBlock x:Name="ShortcutHint" VerticalAlignment="Center" Margin="12,0,0,0"
                                           FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="数据" Style="{StaticResource H2Text}" />
                            <TextBlock x:Name="DataPathText" Style="{StaticResource MutedText}" Margin="0,6,0,12"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="打开数据目录" Style="{StaticResource GhostButton}"
                                        Click="OnOpenDataFolderClick" />
                                <Button Content="立即保存" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                        Click="OnSaveNowClick" />
                                <Button Content="重置分类规则" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                        Click="OnResetRulesClick" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap"
                                       Text="每天一份 Markdown 笔记（notes 目录），结构化索引在 index.json。分类规则在 rules.json，可以直接编辑扩展名和关键词。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,20">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="AboutIcon" Width="52" Height="52" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="鲸记 WhaleLog" Style="{StaticResource H2Text}" />
                                <TextBlock x:Name="AboutVersionText" Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                           Text="数据全部保存在本机，不联网、不上传。" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ 底部拖拽提示 ============ -->
        <Border x:Name="StatusBar" Grid.Row="2" Padding="20,9"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="把文件拖到窗口里即可自动分类归档（原文件不会被移动）" />
                <TextBlock x:Name="StatusRight" HorizontalAlignment="Right" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </Grid>
        </Border>

        <!-- 拖拽悬停高亮 -->
        <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="3"
                Visibility="Collapsed" IsHitTestVisible="False"
                Background="#33000000" BorderThickness="2"
                BorderBrush="{DynamicResource AccentBrush}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="26,20">
                <StackPanel>
                    <Image x:Name="DropOverlayIcon" Source="{v:AssetImage whale-head}"
                           Width="52" Height="52" Stretch="Uniform"
                           HorizontalAlignment="Center" />
                    <TextBlock Text="松手就归档" Margin="0,10,0,0" FontSize="15" FontWeight="Medium"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
