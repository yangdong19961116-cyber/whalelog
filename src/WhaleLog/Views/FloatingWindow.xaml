<Window x:Class="WhaleLog.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:WhaleLog.Views"
        Title="鲸记小鲸鱼"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
        Width="236" Height="296"
        AllowDrop="True">

    <!--
        背景刻意用 alpha=1 而不是 Transparent。

        这个窗口是 AllowsTransparency 的层叠窗口，Windows 对这类窗口的命中测试是
        **逐像素看 alpha** 的：alpha=0 的地方，鼠标点击和文件拖放都会穿到下面的窗口上去。
        真用 Transparent 的话，能接住拖入文件的就只有鲸鱼身上那一小块不透明像素，
        鲸鱼周围的空白全漏下去 —— 拖个文件得瞄准。

        填一层 alpha=1/255 的黑，肉眼完全看不出来（纯白背景上也只是 254,254,254），
        但整块矩形就都能接住了。副作用是点击也不再穿透到下层窗口 —— 对桌宠而言这是改进。
    -->
    <Grid x:Name="RootGrid" Background="#01000000">

        <!-- ===================== 展开态 ===================== -->
        <Grid x:Name="ExpandedRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 气泡：提醒时淡入，几秒后自动淡出 -->
            <Border x:Name="Bubble"
                    Grid.Row="0"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    MaxWidth="228"
                    Margin="4,0,4,8"
                    Padding="11,9"
                    CornerRadius="11"
                    Background="{DynamicResource FloatingBackgroundBrush}"
                    BorderBrush="{DynamicResource FloatingBorderBrush}"
                    BorderThickness="1"
                    Opacity="0"
                    IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock x:Name="BubbleTitle"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="{DynamicResource FloatingTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="BubbleBody"
                               FontSize="12"
                               Margin="0,3,0,0"
                               LineHeight="17"
                               Foreground="{DynamicResource FloatingSubTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 鲸鱼娘本体 -->
            <Grid Grid.Row="1" x:Name="WhaleHitArea" Background="Transparent">
                <Image x:Name="WhaleImage"
                       Source="{v:AssetImage whale}"
                       Stretch="Uniform"
                       Height="168"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!--
                    角标**不挂在这里**了。原先"未收尾条目数"是浮在鲸鱼右上角的一颗圆点，
                    位置随机（鲸鱼居中、形象包宽窄不一，那颗点就飘来飘去），
                    而且和状态条里那行"今天 N 条记录"分别是两个数，看的人得自己对照。
                    现在两个数都收进状态条右上角（见下面 StatusBar 里的 BadgeGroup），
                    鲸鱼身上保持干净。
                -->
            </Grid>

            <!--
                状态条。

                MaxWidth 定在 224（= 基准窗口 236 减去左右各 6 的外边距）：
                它是**版式**，不是形象的一部分 —— 形象包的画布宽了就跟着拉宽，
                会变成一根横贯整个窗口的长条挂在小小的鲸鱼下面。
                dsh 那套画布要 391 宽，不封顶的话这根条就会拉到 379。
                原版（236 宽）封不封都是 224，一个像素不变。
            -->
            <Border x:Name="StatusBar"
                    Grid.Row="2"
                    MaxWidth="224"
                    HorizontalAlignment="Stretch"
                    Margin="6,4,6,6"
                    Padding="10,7"
                    CornerRadius="10"
                    Background="{DynamicResource FloatingBackgroundBrush}"
                    BorderBrush="{DynamicResource FloatingBorderBrush}"
                    BorderThickness="1">
                <!--
                    两列：左边文字、右边角标。角标那一列 Width="Auto"，
                    Visibility=Collapsed 的元素在 Grid 里不占宽度 ——
                    所以一颗角标都不显示的时候，文字和改动前的位置一模一样，不会凭空缩进。
                -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TodayText"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource FloatingTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="CountdownText"
                                   FontSize="11.5"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource FloatingSubTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!--
                        两颗数字角标，浮在状态条右上角。

                        负外边距是故意的：要的是"骑在角上"那点飘出去的感觉 ——
                        往上 9、往右 8，角标顶边探出状态条上边框一点点。
                        负过头会被窗口裁掉，所以余量是按实际尺寸留的：
                        StatusBar 距窗口右边 6（自己 Margin="6,4,6,6"）、内边距又缩进 10，
                        角标最多能往右探 16 还留在窗口里，这里只用了 8。

                        两颗的语义不同，所以颜色分开：
                          记录数（今天归档了几条）—— AccentBrush，就是那颗蓝紫圆点；
                          未收尾（还有几条没收尾）—— WarningBrush，语义是"待办"。
                        两颗都为 0 时整组 collapsed：状态条本来就写着"今天还没有记录"，
                        再挂个 0 是噪音。
                    -->
                    <StackPanel x:Name="BadgeGroup"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                Margin="6,-9,-8,0">
                        <Border x:Name="TodayBadge"
                                MinWidth="21" Height="21"
                                CornerRadius="10.5"
                                Padding="6,0"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock x:Name="TodayBadgeText"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource AccentForegroundBrush}" />
                        </Border>
                        <Border x:Name="OpenBadge"
                                Margin="4,0,0,0"
                                MinWidth="21" Height="21"
                                CornerRadius="10.5"
                                Padding="6,0"
                                Background="{DynamicResource WarningBrush}">
                            <!--
                                这里的字色是**写死**的深墨，不跟 AccentForegroundBrush 走。
                                那一只是"在强调色上写字"的通用笔，浅色主题下是纯白 ——
                                白字压在琥珀底（#C07C22）上只有 3.4:1，11px 的数字读起来发虚。
                                两种主题的琥珀都是中等亮度的暖色（#C07C22 / #DDA44E），
                                深墨在两边分别是 6:1 和 8.5:1，所以干脆两边都写深色。
                            -->
                            <TextBlock x:Name="OpenBadgeText"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="#1B1D22" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== 收起态（贴边小胶囊） ===================== -->
        <Border x:Name="CollapsedRoot"
                Width="60" Height="60"
                CornerRadius="30"
                Visibility="Collapsed"
                Background="{DynamicResource FloatingBackgroundBrush}"
                BorderBrush="{DynamicResource FloatingBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Image x:Name="HeadImage"
                       Source="{v:AssetImage whale-head}"
                       Width="46" Height="46"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Border x:Name="CollapsedBadge"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,2,2,0"
                        MinWidth="19"
                        Height="19"
                        CornerRadius="9.5"
                        Padding="5,0"
                        Background="{DynamicResource AccentBrush}">
                    <TextBlock x:Name="CollapsedBadgeText"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="10.5"
                               FontWeight="Medium"
                               Foreground="{DynamicResource AccentForegroundBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- ===================== 拖入文件时的落点提示 ===================== -->
        <!--
            IsHitTestVisible=False 很要紧：它盖住整块窗口，能命中就会把 DragOver
            从下面的元素手里抢走，落点判定会变得不稳定。
        -->
        <Border x:Name="DropHint"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                CornerRadius="16"
                BorderThickness="2"
                Background="#30000000"
                BorderBrush="{DynamicResource AccentBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                <Image x:Name="DropHintIcon" Source="{v:AssetImage whale-head}"
                       Width="40" Height="40" Stretch="Uniform"
                       HorizontalAlignment="Center" />
                <TextBlock x:Name="DropHintText"
                           Margin="0,8,0,0"
                           FontSize="12.5"
                           FontWeight="Medium"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource FloatingTextBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
