<Window x:Class="WhaleLog.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:WhaleLog.Views"
        Title="日报 / 周报"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="800" Height="660"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif">

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.34" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag">
                <StackPanel Orientation="Horizontal" Margin="16,12,0,12">
                    <Image Source="{v:AssetImage whale-head}"
                           Width="24" Height="24" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Medium" Margin="9,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="SubtitleText" FontSize="11.5" Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>

                <Button Content="✕" Width="38" Height="28" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,12,0"
                        Style="{StaticResource GhostButton}" Padding="0"
                        Click="OnCloseClick" />
            </Grid>

            <!-- 正文：只读 TextBox，方便 Ctrl+A / Ctrl+C -->
            <Border Grid.Row="1" Margin="16,0,16,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="10">
                <TextBox x:Name="Body"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         SelectionBrush="{DynamicResource AccentBrush}"
                         FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI, monospace"
                         FontSize="12.5"
                         Padding="14,12"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="False"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />
            </Border>

            <!-- 底部操作 -->
            <Grid Grid.Row="2" Margin="16,12,16,14">
                <TextBlock x:Name="HintText" VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{DynamicResource TextMutedBrush}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="复制全部" Style="{StaticResource GhostButton}"
                            Click="OnCopyClick" />
                    <Button x:Name="OpenFolderButton" Content="打开所在目录" Margin="8,0,0,0"
                            Style="{StaticResource GhostButton}" Click="OnOpenFolderClick" />
                    <Button Content="关闭" Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButton}" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
