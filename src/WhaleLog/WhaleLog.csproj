<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 不带 OS 版本号的 TFM：本项目只用 WPF / WinForms / 注册表 / System.Drawing，
         不碰任何 WinRT 投影 API，所以不需要引 Microsoft.Windows.SDK.NET.Ref。
         少一个还原依赖，离线环境也更容易构建。 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WhaleLog</RootNamespace>
    <AssemblyName>WhaleLog</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Assets\whalelog.ico</ApplicationIcon>

    <AssemblyTitle>WhaleLog 鲸记</AssemblyTitle>
    <Product>WhaleLog</Product>
    <Description>每日工作记录与文件归档台</Description>
    <Version>1.4.3</Version>
    <Authors>WhaleLog</Authors>
    <Copyright>MIT</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- WFAC010：WinForms 分析器建议用 ApplicationHighDpiMode 代替清单里的 DPI 声明。
         但本项目主体是 WPF，per-monitor v2 的声明必须留在 app.manifest 里
         （托盘图标和悬浮窗都依赖它），所以这里显式抑制。 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms 会隐式 using 整个 System.Windows.Forms / System.Drawing，
         导致 Application、Point、MouseEventArgs、DragEventArgs、IDataObject 这些名字
         和 WPF 的同名类型全面冲突。这里把它们去掉，需要的地方各自显式 using。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Assets\DSniang1.png" />
    <Resource Include="Resources\Assets\closeeye.png" />
    <Resource Include="Resources\Assets\whale-head.png" />
    <Resource Include="Resources\Assets\whalelog.ico" />
    <Resource Include="Resources\Assets\whalelog-256.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="app.manifest">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- 形象包（仓库的 assets\characters\）跟着编译产物走，落到 Assets\characters\。
         为什么必须有这一步：形象按钮是按「程序旁边实际有哪些形象包」动态生成的，
         而打包脚本只把素材放进便携包、不放进 bin\。于是"从 bin 目录直接跑"（开发时
         就是走桌面快捷方式跑这里）看到的是一排按钮里「溟月」灰着写「缺素材」，
         点上去毫无反应 —— 2026-09-20 用户报的正是这个。

         PreserveNewest 是按时间戳增量的：第一次编译拷 274 个文件（约 52 MB），
         之后没改素材就一个都不会重拷。 -->
    <Content Include="..\..\assets\characters\**\*"
             Link="Assets\characters\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
