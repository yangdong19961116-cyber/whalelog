<Window x:Class="AudioRoute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Audio Route"
        Height="680"
        Width="940"
        MinHeight="540"
        MinWidth="720"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded">

    <Border Padding="0" Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Border Grid.Row="0"
                    Padding="22,18"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource SurfaceAltBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <TextBlock Text="Audio Route"
                                   Style="{DynamicResource HeaderTextStyle}" />
                        <TextBlock x:Name="SubtitleText"
                                   Margin="0,2,0,0"
                                   Style="{DynamicResource SubtleTextStyle}"
                                   Text="Auto-switch Windows audio output — by hotkey, or when a 2.4G dongle connects." />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Padding="10,4"
                                CornerRadius="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot"
                                         Width="8" Height="8"
                                         Margin="0,0,8,0"
                                         Fill="{DynamicResource SuccessBrush}" />
                                <TextBlock x:Name="StatusText"
                                           Text="Listening"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="HideButton"
                                Content="Hide to tray"
                                Margin="8,0,0,0"
                                Padding="12,5"
                                Click="HideButton_Click"
                                Style="{DynamicResource GhostButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Body ===== -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ----- Card 1: Current output ----- -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="Current output"
                                           Style="{DynamicResource SectionTitleStyle}"
                                           DockPanel.Dock="Left" />
                                <TextBlock x:Name="DeviceStateBadge"
                                           Text=""
                                           Style="{DynamicResource SubtleTextStyle}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>

                            <TextBlock x:Name="CurrentDeviceName"
                                       Text="(initialising…)"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,4"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="CurrentDeviceId"
                                       Style="{DynamicResource SubtleTextStyle}"
                                       Margin="0,0,0,16"
                                       TextTrimming="CharacterEllipsis"
                                       Text="" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="◀ Previous"
                                        Margin="0,0,4,0"
                                        Click="PrevDevice_Click"
                                        Style="{DynamicResource GhostButtonStyle}" />
                                <Button Grid.Column="1"
                                        Content="Next ▶"
                                        Margin="4,0"
                                        Click="NextDevice_Click"
                                        Style="{DynamicResource GhostButtonStyle}" />
                                <Button Grid.Column="2"
                                        Content="Cycle"
                                        Margin="4,0,0,0"
                                        Click="Cycle_Click"
                                        Style="{DynamicResource PrimaryButtonStyle}" />
                            </Grid>

                            <!-- Volume row -->
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Volume"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Slider Grid.Column="1"
                                        x:Name="VolumeSlider"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="70"
                                        TickFrequency="5"
                                        VerticalAlignment="Center"
                                        IsMoveToPointEnabled="True"
                                        PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseUp"
                                        ValueChanged="VolumeSlider_ValueChanged" />
                                <TextBlock Grid.Column="2"
                                           x:Name="VolumeLabel"
                                           Text="70%"
                                           Width="44"
                                           TextAlignment="Right"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>

                            <DockPanel Margin="0,14,0,0">
                                <Button x:Name="MuteButton"
                                        Content="Mute"
                                        Padding="14,6"
                                        Click="MuteButton_Click"
                                        Style="{DynamicResource GhostButtonStyle}"
                                        DockPanel.Dock="Left" />
                                <TextBlock x:Name="MuteIndicatorText"
                                           Text=""
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{DynamicResource SubtleTextStyle}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- ----- Card 2: Auto switch ----- -->
                    <Border Grid.Row="0" Grid.Column="2" Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Auto-switch on 2.4G dongle"
                                           Style="{DynamicResource SectionTitleStyle}"
                                           DockPanel.Dock="Left" />
                                <CheckBox x:Name="AutoSwitchToggle"
                                          DockPanel.Dock="Right"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Checked="AutoSwitch_Toggle"
                                          Unchecked="AutoSwitch_Toggle" />
                            </DockPanel>

                            <TextBlock Margin="0,4,0,0" Style="{DynamicResource SubtleTextStyle}"
                                       Text="Enable to switch outputs the moment a matching dongle is plugged in." />

                            <TextBlock Text="Trigger pattern (device name contains)"
                                       Style="{DynamicResource SubtleTextStyle}"
                                       Margin="0,14,0,4" />
                            <ComboBox x:Name="TriggerCombo"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      Loaded="TriggerCombo_Loaded"
                                      SelectionChanged="TriggerCombo_Changed" />
                            <Border BorderThickness="0,0,0,1"
                                    Margin="0,-1,0,0"
                                    Height="1"
                                    Background="{DynamicResource BorderBrush}"
                                    IsHitTestVisible="False" />

                            <TextBlock Text="Fallback device when trigger disconnects"
                                       Style="{DynamicResource SubtleTextStyle}"
                                       Margin="0,14,0,4" />
                            <ComboBox x:Name="FallbackCombo"
                                      SelectionChanged="FallbackCombo_Changed" />

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,16,0,0">
                                <TextBlock Style="{DynamicResource SubtleTextStyle}"
                                           Text="Tip: pick a 2.4G dongle pattern like “2.4G”, “G733”, or the USB receiver's friendly name. The app watches for any 'device added' / 'state changed' event whose name contains it." />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ----- Card 3: Hotkeys ----- -->
                    <Border Grid.Row="2" Grid.Column="0" Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Hotkeys"
                                       Style="{DynamicResource SectionTitleStyle}" />

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Cycle playback"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         x:Name="CycleHotkeyBox"
                                         Width="220"
                                         Margin="0,4"
                                         Style="{DynamicResource ModernTextBoxStyle}"
                                         KeyDown="HotkeyBox_KeyDown"
                                         Tag="CycleHotkey" />

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Next device"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         x:Name="NextHotkeyBox"
                                         Width="220"
                                         Margin="0,4"
                                         Style="{DynamicResource ModernTextBoxStyle}"
                                         KeyDown="HotkeyBox_KeyDown"
                                         Tag="NextDeviceHotkey" />

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Previous device"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         x:Name="PrevHotkeyBox"
                                         Width="220"
                                         Margin="0,4"
                                         Style="{DynamicResource ModernTextBoxStyle}"
                                         KeyDown="HotkeyBox_KeyDown"
                                         Tag="PrevDeviceHotkey" />

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="Mute toggle"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1"
                                         x:Name="MuteHotkeyBox"
                                         Width="220"
                                         Margin="0,4"
                                         Style="{DynamicResource ModernTextBoxStyle}"
                                         KeyDown="HotkeyBox_KeyDown"
                                         Tag="MuteHotkey" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Apply hotkeys"
                                        Click="ApplyHotkeys_Click"
                                        Padding="14,7"
                                        Style="{DynamicResource PrimaryButtonStyle}" />
                                <Button Content="Reset to defaults"
                                        Margin="8,0,0,0"
                                        Click="ResetHotkeys_Click"
                                        Padding="14,7"
                                        Style="{DynamicResource GhostButtonStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="HotkeyStatus"
                                       Margin="0,8,0,0"
                                       Style="{DynamicResource SubtleTextStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- ----- Card 4: Settings ----- -->
                    <Border Grid.Row="2" Grid.Column="2" Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Settings"
                                       Style="{DynamicResource SectionTitleStyle}" />

                            <CheckBox x:Name="StartWithWindowsCheck"
                                      Content="Start with Windows"
                                      Margin="0,8,0,0"
                                      Checked="StartWithWindows_Changed"
                                      Unchecked="StartWithWindows_Changed" />
                            <CheckBox x:Name="StartMinimizedCheck"
                                      Content="Start minimized (tray only)"
                                      Margin="0,6,0,0"
                                      Checked="StartMinimized_Changed"
                                      Unchecked="StartMinimized_Changed" />

                            <TextBlock Text="Theme"
                                       Style="{DynamicResource SubtleTextStyle}"
                                       Margin="0,16,0,4" />
                            <ComboBox x:Name="ThemeCombo"
                                      SelectionChanged="ThemeCombo_Changed">
                                <ComboBoxItem Content="Follow system" Tag="System" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>

                            <Border BorderThickness="0,1,0,0"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Margin="0,16,0,0" />

                            <TextBlock Style="{DynamicResource SubtleTextStyle}"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Text="Hotkeys are global and work while the app is in the tray. Auto-switch looks at every device-added / state-changed event from Windows and matches names by 'contains' (case-insensitive)." />
                            <TextBlock x:Name="BuildInfo"
                                       Style="{DynamicResource SubtleTextStyle}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- ===== Status bar ===== -->
            <Border Grid.Row="2"
                    Padding="22,10"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource SurfaceAltBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               x:Name="LastEventText"
                               Text=""
                               Style="{DynamicResource SubtleTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               x:Name="DeviceCountText"
                               Text="0 devices"
                               Margin="20,0,0,0"
                               Style="{DynamicResource SubtleTextStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
